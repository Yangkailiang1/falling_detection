.page { padding: 20rpx; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.tip { color: #8a8fa8; font-size: 24rpx; margin-top: 16rpx; }
.device-row { display: flex; justify-content: space-between; align-items: center; }
.device-status { color: #f56c6c; }
.device-status.online { color: #67c23a; }
.actions { margin-top: 30rpx; }
.error-text { color: #e6a23c; font-size: 24rpx; margin-top: 16rpx; word-break: break-all; }
.help-card { background: #f0f6ff; }
.help-text { color: #5b8cff; font-size: 26rpx; line-height: 1.6; }
