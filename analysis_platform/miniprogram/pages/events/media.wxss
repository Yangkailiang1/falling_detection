.page { padding-bottom: 60rpx; }
.header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 30rpx; background: #1a1a3a; color: #fff;
  position: sticky; top: 0; z-index: 10;
}
.back { font-size: 28rpx; width: 120rpx; }
.header-title { font-size: 32rpx; font-weight: 600; }
.header-right { font-size: 24rpx; color: #a0a8c8; width: 120rpx; text-align: right; }

.summary-card {
  background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.summary-time { color: #8a8fa8; font-size: 24rpx; margin-bottom: 12rpx; }
.summary-row { display: flex; align-items: center; justify-content: space-between; }
.risk-tag { padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; color: #fff; }
.risk-I { background: #f56c6c; }
.risk-II { background: #e6a23c; }
.risk-III { background: #67c23a; }
.summary-loc { color: #444; font-size: 26rpx; font-weight: 600; }
.summary-desc { color: #666; font-size: 26rpx; margin-top: 12rpx; line-height: 1.6; }

.card {
  background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.section-title { font-weight: 600; font-size: 30rpx; margin-bottom: 16rpx; }
.capture-img { width: 100%; border-radius: 12rpx; background: #f0f2f5; }
.img-error {
  width: 100%; height: 240rpx; border-radius: 12rpx;
  background: #f0f2f5; color: #8a8fa8; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.video-player { width: 100%; height: 420rpx; border-radius: 12rpx; background: #111; }
.video-tip { color: #8a8fa8; font-size: 22rpx; margin-top: 12rpx; }
.no-video {
  padding: 40rpx 0; text-align: center; color: #8a8fa8; font-size: 26rpx;
  background: #f8f9fc; border-radius: 12rpx;
}
.actions { margin-top: 10rpx; }
.btn-primary {
  background: #5b8cff; color: #fff; text-align: center;
  border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; font-weight: 600;
}
