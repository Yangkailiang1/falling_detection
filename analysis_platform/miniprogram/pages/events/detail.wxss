.page { padding-bottom: 60rpx; }
.risk-banner { padding: 40rpx; color: #fff; }
.risk-title { font-size: 36rpx; font-weight: 700; }
.risk-time { margin-top: 8rpx; font-size: 24rpx; opacity: 0.85; }
.risk-I { background: linear-gradient(160deg, #f56c6c, #d43c3c); }
.risk-II { background: linear-gradient(160deg, #e6a23c, #c07d1e); }
.risk-III { background: linear-gradient(160deg, #67c23a, #4a9c22); }
.section-title { font-weight: 600; margin-bottom: 16rpx; }
.capture-tip { font-size: 22rpx; color: #b8c4e8; font-weight: 400; margin-left: 12rpx; }

/* 现场抓拍 */
.capture-card { padding: 20rpx; }
.capture-img {
  width: 100%; height: 420rpx; border-radius: 12rpx;
  background: #f0f2f5; display: block;
}
.img-error {
  width: 100%; height: 420rpx; border-radius: 12rpx;
  background: #f0f2f5; color: #8a8fa8; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 跌倒分析 — 信息网格 (2列 Grid, 修复排版错乱) */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.info-cell {
  padding: 20rpx 16rpx;
  display: flex; flex-direction: column; align-items: center;
  background: #f8f9fc; border-radius: 12rpx;
}
.cell-label { color: #8a8fa8; font-size: 24rpx; margin-bottom: 8rpx; }
.cell-value { font-size: 30rpx; font-weight: 600; color: #2a2a3a; }
.cell-strong { color: #f56c6c; }

/* 事件信息 */
.info-row { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 2rpx solid #f0f1f6; }
.info-row .label { color: #8a8fa8; }
.info-row text:last-child { max-width: 60%; text-align: right; word-break: break-all; }

/* 医疗简报 */
.report-recommend {
  background: #f0f6ff; color: #5b8cff;
  padding: 16rpx; border-radius: 10rpx; margin-bottom: 16rpx;
  font-size: 26rpx;
}
.report-text { color: #444; font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; }

/* 操作 — 2×2 宫格按钮 (替代原 flex 横排, 长文字不再挤成一横条) */
.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 26rpx 12rpx;
  border-radius: 14rpx;
  background: #f8f9fc;
  border: 2rpx solid #eef0f6;
}
.action-btn:active { opacity: 0.75; }
.action-icon { font-size: 40rpx; line-height: 1; margin-bottom: 10rpx; }
.action-title { font-size: 28rpx; font-weight: 600; color: #2a2a3a; }
.action-sub { font-size: 22rpx; color: #8a8fa8; margin-top: 4rpx; }
/* 主操作: 视频类 (蓝) */
.action-primary { background: #f0f6ff; border-color: #5b8cff; }
.action-primary .action-title { color: #3a6df0; }
/* 危险操作: 误报 (红) */
.action-danger { background: #fef3f3; border-color: #f8d7d7; }
.action-danger .action-title { color: #f56c6c; }
