.page { padding: 20rpx; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.tip { color: #8a8fa8; font-size: 24rpx; margin-bottom: 30rpx; }
.form-item { margin-bottom: 30rpx; }
.label { display: block; font-size: 26rpx; color: #555; margin-bottom: 10rpx; }
.input {
  border: 2rpx solid #dde0ea;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}
.scan-card { text-align: center; color: #5b8cff; }
.device-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0; border-bottom: 2rpx solid #f0f1f6;
}
.device-item:last-child { border-bottom: none; }
.device-info { display: flex; flex-direction: column; }
.device-name { font-weight: 600; }
.device-sn { color: #8a8fa8; font-size: 24rpx; margin-top: 4rpx; }
.device-status { color: #8a8fa8; font-size: 24rpx; }
.device-status.online { color: #67c23a; }
