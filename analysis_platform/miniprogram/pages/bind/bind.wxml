<view class="page">
  <view class="card">
    <view class="title">绑定摄像头设备</view>
    <view class="tip">摄像头已用萤石 App 配网。输入设备序列号（机身标签或萤石 App 设备信息中查看）</view>

    <view class="form-item">
      <text class="label">设备序列号</text>
      <input class="input" placeholder="如 BW0478764" value="{{deviceSerial}}" bindinput="onSerial" />
    </view>

    <view class="btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submit" wx:if="{{!submitting}}">
      确认绑定
    </view>
    <view class="btn-primary disabled" wx:else>绑定中...</view>
  </view>

  <!-- 自动发现 -->
  <view class="card" wx:if="{{discovered.length}}">
    <view class="title">发现以下设备（点击绑定）</view>
    <view class="device-item" wx:for="{{discovered}}" wx:key="device_serial" bindtap="bindFromList" data-serial="{{item.device_serial}}" data-name="{{item.device_name}}">
      <view class="device-info">
        <text class="device-name">{{item.device_name || item.device_serial}}</text>
        <text class="device-sn">{{item.device_serial}}</text>
      </view>
      <text class="device-status {{item.status === 'online' ? 'online' : ''}}">{{item.status === 'online' ? '🟢 在线' : '⚪ 离线'}}</text>
    </view>
  </view>
  <view class="card scan-card" bindtap="scanCode">
    <text>📷 扫码绑定（扫设备机身二维码）</text>
  </view>
</view>
